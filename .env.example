# Copy to .env.local and fill in. Never commit .env.local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-4-5, which is what the 8s client timeout
# wants. Note that claude-haiku-4-5 rejects output_config.effort; api/extract.ts
# only sends effort to models that accept it.
ANTHROPIC_MODEL=claude-haiku-4-5

# Telegram bot token from @BotFather. SERVER-SIDE ONLY — never give this a VITE_
# prefix: Vite inlines VITE_ variables into the browser bundle, which would
# publish the token. bot/config.ts refuses to start if it finds a VITE_ copy.
TELEGRAM_BOT_TOKEN=

# Optional. The bot's public @username, shown next to the link code on the
# midwife's screen. Public information, so a VITE_ prefix is fine here — unlike
# the token above.
VITE_TELEGRAM_BOT_USERNAME=

# Optional. The bot signs in anonymously with the anon key by default, which is
# enough for the RLS policies. Set this only if the bot needs to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=
